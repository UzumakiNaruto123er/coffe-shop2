# BLOO COFFEE — Environment Variables
# Copy this file to `.env.local` and fill in only what you need.
# All values here are safe to expose in the deployed app.

# Public site URL (used for canonical URLs, sitemap, hreflang, OG metadata).
# Defaults to https://coffe-shop-2.vercel.app when not set.
NEXT_PUBLIC_SITE_URL=https://coffe-shop-2.vercel.app

# Optional: when set, the Contact page shows a mailto form addressed to this
# inbox. When left unset, the Contact page offers phone/Instagram instead.
# CONTACT_EMAIL=hello@bloo.example